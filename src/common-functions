function __log() {
    local severity=${1:?Need severity}
    shift
    echo "[${severity}]" "$(date '+%Y%m%dT%H%M%S')" "$(basename "${0}")" "${@:-}" >/dev/stderr
}

function log() {
    local severity=${1:?Need severity}
    shift
    if [[ $# -gt 0 ]]; then
        __log "${severity}" "${@}"
    else
        while read -r line; do
            __log "${severity}" "${line}"
        done
    fi
}

function debug() {
    log DEBUG "$@"
}

function error() {
    log ERROR "$@"
    exit "${EXIT_CODE:-1}"
}

function ignore() {
    log IGNORE "$@"
}

function info() {
    log INFO "$@"
}

function is_true() {
    echo "${1:?Need argument}" | grep -Eiq '^\s*(1|true|t|yes|y)\s*$'
}

function run_once_before_schedule() {
    # touch_healthcheck_startup_marker's grace period is a cheap, instant
    # placeholder -- it expires (default 900s) long before the first real
    # run of an infrequent schedule (daily, every-8-hours), so a fresh
    # deployment would flip unhealthy waiting on the grace period alone.
    # Run the backup command once for real, right here, before scheduler
    # mode hands off to supercronic, so a genuine HEALTHCHECK_SUCCESS_FILE
    # marker exists well within the grace window. A failure here is logged
    # but does not block scheduler mode -- the regular schedule gets its
    # own future attempts regardless of how this first one goes.
    # Usage:
    #   run_once_before_schedule COMMAND [ARGS...]
    [[ $# -gt 0 ]] || return 1
    info "running once immediately before scheduler hand-off: $*"
    if "$@"; then
        info "immediate pre-schedule run succeeded"
    else
        log WARN "immediate pre-schedule run failed (continuing to scheduler mode regardless): $*"
    fi
    return 0
}

function touch_healthcheck_startup_marker() {
    # healthcheck-base's grace-period check reads HEALTHCHECK_STARTUP_FILE
    # to tell "just started, first backup hasn't run yet" apart from
    # "actually stuck" -- call this once from scheduler-mode startup,
    # before installing the crontab, so a fresh deployment reports healthy
    # immediately instead of waiting for the first scheduled backup to
    # complete. A derivative that leaves HEALTHCHECK_STARTUP_FILE unset is
    # not using the grace-period feature; do nothing rather than erroring
    # on an intentionally-absent variable.
    [[ -n "${HEALTHCHECK_STARTUP_FILE:-}" ]] && touch "${HEALTHCHECK_STARTUP_FILE}"
    return 0
}

function path-append() {
    local p="${1%/}"
    path-remove "${p}" >/dev/null
    export PATH="${PATH}:${p}"
    echo "${PATH}"
}

function path-prepend() {
    local p="${1%/}"
    path-remove "${p}" >/dev/null
    export PATH="${p}:${PATH}"
    echo "${PATH}"
}

function path-remove() {
    local dir="${1%/}" IFS=: result=() p
    [[ -z "${dir}" ]] && return 1
    for p in ${PATH}; do
        [[ "${p}" != "${dir}" ]] && result+=("${p}")
    done
    local path="${result[*]}"
    path="${path#:}"
    export PATH="${path%:}"
    echo "${PATH}"
}
