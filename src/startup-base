# Retained for deployments that set:
#   entrypoint: /usr/local/bin/startup-base
# Use the application binary directly with --cron in new deployments.
#
# Required environment variable:
#   STARTUP_COMMAND — path to the application binary (e.g., /usr/local/bin/pfsense-backup)

exec "${STARTUP_COMMAND:?Need STARTUP_COMMAND env var}" --cron "$@"
